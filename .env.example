# Copy this file to .env before running `docker compose up`.
# These values are for local development only. Use real secrets in production.

DB_DATABASE=ride_booking
DB_USERNAME=ride_app
DB_PASSWORD=change-me-local
DB_ROOT_PASSWORD=change-me-local-root

# Reverb (WebSocket server). The key is public, the secret stays on the server.
REVERB_APP_ID=ride-booking
REVERB_APP_KEY=ride-booking-local-key
REVERB_APP_SECRET=change-me-local-secret

# Load demo riders, drivers and Lahore places on startup.
AUTO_SEED=true

# Host ports. MySQL uses 3307 so it doesn't clash with a local MySQL on 3306.
API_HOST_PORT=8000
WEB_HOST_PORT=3000
REVERB_HOST_PORT=8080
MYSQL_HOST_PORT=3307
